{
  "name": "portfolio",
  "compatibility_date": "2026-11-03",
  "main": "api/index.ts",
  "browser": { "binding": "BROWSER" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "hayatro.id", "custom_domain": true }],
  "preview_urls": true,
  "previews": { "browser": { "binding": "BROWSER" } },
}
