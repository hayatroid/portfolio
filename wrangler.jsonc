{
  "name": "portfolio",
  "compatibility_date": "2026-11-03",
  "main": "api/index.ts",
  "browser": { "binding": "BROWSER" },
  "kv_namespaces": [
    { "binding": "ATCODER", "id": "13e5a7aa155e4117a046e94b381148fe" },
  ],
  "triggers": { "crons": ["0 15 * * *"] },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "hayatro.id", "custom_domain": true }],
  "preview_urls": true,
  "previews": {
    "browser": { "binding": "BROWSER" },
    "kv_namespaces": [
      { "binding": "ATCODER", "id": "13e5a7aa155e4117a046e94b381148fe" },
    ],
  },
}
