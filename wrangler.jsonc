{
  "name": "portfolio",
  "compatibility_date": "2026-11-03",
  "main": "api/index.ts",
  "build": { "command": "bash ./build.sh" },
  "browser": { "binding": "BROWSER" },
  "kv_namespaces": [
    { "binding": "ATCODER", "id": "13e5a7aa155e4117a046e94b381148fe" },
  ],
  "triggers": { "crons": ["0 15 * * *"] },
  "containers": [{ "class_name": "Sandbox", "image": "./sandbox.Dockerfile", "instance_type": "basic" }],
  "durable_objects": { "bindings": [{ "name": "SANDBOX", "class_name": "Sandbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sandbox"] }],
  "secrets": { "required": ["TURNSTILE_SECRET"] },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "routes": [{ "pattern": "hayatro.id", "custom_domain": true }],
  "preview_urls": true,
  "previews": {
    "browser": { "binding": "BROWSER" },
    "kv_namespaces": [
      { "binding": "ATCODER", "id": "13e5a7aa155e4117a046e94b381148fe" },
    ],
    "durable_objects": { "bindings": [{ "name": "SANDBOX", "class_name": "Sandbox" }] },
    "containers": [{ "class_name": "Sandbox", "image": "./sandbox.Dockerfile", "instance_type": "basic" }],
  },
}
